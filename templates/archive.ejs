<div class="n">全部文章</div>
<div class="t">共 <span id="postCount"><%= posts.length %></span> 篇文章</div>

<input type="text" id="searchInput" class="s-i" placeholder="搜索文章标题、专栏、日期...">

<div class="l" id="postList">
    <% posts.forEach(post => { %>
        <div class="i" data-title="<%= (post.title + ' ' + post.column + ' ' + post.date).toLowerCase() %>">
            <a href="/posts/<%= post.hash %>.html">
                <div class="i-t"><%= post.title %></div>
                <div class="i-m"><%= post.column %> · <%= post.date %></div>
            </a>
        </div>
    <% }) %>
</div>
